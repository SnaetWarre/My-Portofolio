---
import "../styles/schematic.css";
import { drawings, type DrawingKey } from "../lib/drawings";
import { renderSchematic } from "../lib/schematic";

interface Props {
  drawing: DrawingKey;
  /** "lead" for a small drawing shown large. */
  size?: "lead" | "inline";
}

const { drawing, size = "inline" } = Astro.props;
const svg = renderSchematic(drawings[drawing], { className: size === "lead" ? "lead" : undefined });
---

<Fragment set:html={svg} />
