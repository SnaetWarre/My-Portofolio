---
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { nextProject } from "../lib/projects";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Props {
  /** Site-relative address of the current page, as listed in lib/projects. */
  href: string;
}

const next = nextProject(Astro.props.href);
---

<footer {...stylex.attrs(portfolioStyles.pageEnd)}>
  {next && (
    <>
      <p {...stylex.attrs(portfolioStyles.pageEndLabel)}>Next</p>
      <p {...stylex.attrs(portfolioStyles.pageEndNext)}><a {...stylex.attrs(portfolioStyles.rowLink)} href={next.href}>{next.title}</a></p>
    </>
  )}
  <a {...stylex.attrs(portfolioStyles.link)} href={`${basePath}#work`}>Back to the list</a>
</footer>
