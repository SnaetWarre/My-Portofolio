---
const isDevelopment = import.meta.env.DEV;
---

{isDevelopment && (
  <>
    <link rel="stylesheet" href="/virtual:stylex.css" />
    <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>
    <script is:inline>
      // The StyleX dev runtime replaces the stylesheet link above with a style
      // element it injects, and disables the link. Astro's client router drops
      // head elements the next page does not have, so without this every style
      // vanished after the first in-site navigation during development.
      // Marking the injected element as persisted keeps it across the swap.
      if (!window.__stylexDevStylesKept) {
        window.__stylexDevStylesKept = true;
        document.addEventListener("astro:before-swap", (event) => {
          const injected = document.getElementById("__stylex_virtual__");
          if (!injected) return;
          injected.setAttribute("data-astro-transition-persist", "stylex-dev");
          const match = event.newDocument.createElement("style");
          match.setAttribute("data-astro-transition-persist", "stylex-dev");
          event.newDocument.head.append(match);
        });
      }
    </script>
  </>
)}
