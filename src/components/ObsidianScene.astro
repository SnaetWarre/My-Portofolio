---
import * as stylex from "@stylexjs/stylex";
import { obsidianStyles as styles } from "../styles/obsidianStyles";
---

<div {...stylex.attrs(styles.scene)} aria-hidden="true" transition:persist="obsidian-scene" transition:animate="none">
  <canvas {...stylex.attrs(styles.canvas)} data-obsidian></canvas>
  <div {...stylex.attrs(styles.veil)}></div>
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>("canvas[data-obsidian]");
  if (canvas && !canvas.dataset.mounted) {
    // Never mount the WebGL sculpture on phones, in either theme.
    // This also skips downloading three.js on mobile.
    const isPhone = window.matchMedia("(max-width: 700px)");
    const mount = () => {
      if (canvas.dataset.mounted) return;
      canvas.dataset.mounted = "true";
      import("../scripts/obsidian")
        .then(({ mountObsidian }) => mountObsidian(canvas))
        .catch(() => { canvas.dataset.state = "unavailable"; });
    };
    if (isPhone.matches) {
      canvas.dataset.state = "unavailable";
      // Phone rotated to landscape / tablet width: mount once it stops being a phone.
      isPhone.addEventListener("change", (event) => {
        if (!event.matches) mount();
      }, { once: true });
    } else {
      mount();
    }
  }
</script>
