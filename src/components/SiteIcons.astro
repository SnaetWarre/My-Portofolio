---
import { basePath } from "../lib/paths";

const base = basePath;
---

<meta name="theme-color" content="#ffffff" data-theme-color />
<meta name="application-name" content="Warre Snaet" />
<meta name="apple-mobile-web-app-title" content="Warre Snaet" />
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="alternate icon" href={`${base}favicon.ico`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
<link rel="manifest" href={`${base}site.webmanifest`} />
