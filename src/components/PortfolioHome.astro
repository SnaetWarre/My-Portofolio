---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "./ProjectList.astro";
import { obsidianStyles } from "../styles/obsidianStyles";

import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Props { experimental?: boolean; }
const { experimental = false } = Astro.props;

const base = basePath;
const year = new Date().getFullYear();

const experience = [
  {
    title: "Medical imaging at 2Ai IPCA",
    context: "AI & software engineering intern",
    href: `${base}work/medical-imaging.html`,
    description: "An international internship working with real clinical imaging data. I wrote a Python pipeline that reads measurements out of DICOM studies with OCR, along with review tools, resumable batch processing, ECG extraction, and a source-video matcher. Filtering candidates on metadata before aligning images cut one representative run from about 21 hours to 23 minutes.",
  },
  {
    title: "Apolloon 24-hour run system",
    context: "Software engineer, paid client work",
    href: `${base}work/apolloon.html`,
    description: "Software for running a 24-hour relay on the event's own network. Every Electron host has its own writable SQLite database. Hosts pair once, find each other again through signed UDP announcements on the LAN, and send each other only the operations the other side is missing, over authenticated HTTP.",
  },
];

const selectedWork = [
  {
    title: "AWS Fargate & Vault workload identity",
    href: `${base}work/aws-fargate-vault.html`,
    description: "Terraform for private ECS Fargate tasks behind an ALB, spread over two availability zones. Tasks log in to Vault with their IAM role, and the setup includes CloudWatch monitoring, autoscaling, health checks, and safeguards around deploys. The plans are tested against mocked providers.",
  },
  {
    title: "Financial AI agent",
    href: `${base}work/financial-agent.html`,
    description: "A chat app for a simulated investment portfolio, split over six services: a streaming FastAPI backend, tools behind MCP, RAG with ChromaDB, PostgreSQL, a React frontend, and local models through Ollama. We were two people on this school project. I did the backend architecture, orchestration, persistence, containers, and tests, plus most of the frontend integration.",
  },
  {
    title: "Azure ML lifecycle",
    href: `${base}work/azure-mlops.html`,
    description: "Solo MLOps coursework. Data preparation runs in parallel on Azure ML compute, runs are tracked with MLflow, and the registered model is served by FastAPI in Docker, with Kubernetes manifests and GitHub Actions for delivery.",
  },
  {
    title: "Semi-supervised learning in Rust",
    href: `${base}blog/blog.html`,
    description: "My bachelor research: classifying plant diseases on edge devices when only a small part of the data is labeled. The semi-supervised model scored 94.90% on a held-out test set and runs in an offline app of about 26 MB, which I tested on an iPhone.",
  },
  {
    title: "Event chatbot for XPO Group",
    href: `${base}work/xpo-chatbot.html`,
    description: "A school team project for an outside client. It's a full-stack RAG chatbot: Python scrapers collect the event content, a .NET API answers questions with Azure OpenAI and Cosmos DB, and a Next.js dashboard shows the analytics.",
  },
  {
    title: "Dataset query system",
    href: `${base}work/dataset-query.html`,
    description: "A Python client-server app for querying a shared dataset. It has logins, moderator tools, usage statistics, server broadcasts, and a PySide6 desktop interface.",
  },
];

const openSource = [
  {
    title: "Athas code editor",
    context: "Maintainer & contributor",
    href: `${base}work/athas.html`,
    description: "I work on both the React/TypeScript side and the Tauri/Rust side of the editor. My merged changes include C# language support, image diffs, Linux UI fixes, dynamic proxy ports, fixes for resource and memory leaks, and a fix for a race condition in the language server handling.",
  },
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Warre Snaet",
    jobTitle: "Junior Backend and Applied AI Engineer",
    url: "https://snaetwarre.github.io/My-Portofolio/",
    sameAs: ["https://www.linkedin.com/in/warre-snaet-272354370/", "https://github.com/SnaetWarre"],
    alumniOf: { "@type": "EducationalOrganization", name: "Howest University of Applied Sciences" },
  },
};
---

<BaseLayout
  experimental={experimental}
  sculpture
  title="Warre Snaet | Backend & Applied AI Engineer"
  description="Portfolio of Warre Snaet, a backend and applied AI engineer from Belgium. Mostly Python: backend systems, data pipelines, agent infrastructure, and machine learning applications."
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(profileSchema)} /></Fragment>
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#main">Skip to content</a>
  <main {...stylex.attrs(portfolioStyles.mainContent, obsidianStyles.content)} id="main" tabindex="-1">
    <div {...stylex.attrs(obsidianStyles.hero)}>
    <header {...stylex.attrs(portfolioStyles.pageHeader)}>
      <h1 {...stylex.attrs(portfolioStyles.primaryHeading, obsidianStyles.heading)}>Warre Snaet</h1>
      <nav {...stylex.attrs(portfolioStyles.navigation)} aria-label="Portfolio and profile links">
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href="https://github.com/SnaetWarre">GitHub</a>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href="https://www.linkedin.com/in/warre-snaet-272354370/">LinkedIn</a>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href={`${base}cv.html`}>CV</a>
      </nav>
    </header>

    <section {...stylex.attrs(portfolioStyles.introduction)} aria-labelledby="about-title">
      <h2 {...stylex.attrs(portfolioStyles.visuallyHidden)} id="about-title">About</h2>
      <p {...stylex.attrs(portfolioStyles.lead)}>I’m a backend and applied AI engineer from Belgium. I studied AI Engineering at Howest and graduated with distinction.</p>
      <p {...stylex.attrs(portfolioStyles.paragraph, portfolioStyles.supportingText)}>I do my best work in Python. That covers APIs, data pipelines, computer vision and OCR, and machine learning, including reinforcement learning and generative AI. For infrastructure I use AWS, Azure, Terraform, containers, Kubernetes, and CI/CD. The areas I’m most interested in are agent infrastructure and MLOps.</p>
      <p {...stylex.attrs(portfolioStyles.paragraph, portfolioStyles.supportingText)}>I’m looking for a junior role in cloud, backend, software, data, or applied AI engineering.</p>
      <div {...stylex.attrs(portfolioStyles.contactRow)}>
        <button {...stylex.attrs(portfolioStyles.copyEmailButton)} type="button" data-copy-email>Copy email</button>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href={`${base}cv.html`}>View my CV</a>
      </div>
    </section>

    </div>

    <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="experience-title">
      <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="experience-title">Experience</h2>
      <ProjectList projects={experience} />
    </section>

    <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="work-title">
      <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="work-title">Selected work</h2>
      <ProjectList projects={selectedWork} />
    </section>

    <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="open-source-title">
      <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="open-source-title">Open source</h2>
      <ProjectList projects={openSource} />
    </section>

    <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="writing-title">
      <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="writing-title">Writing</h2>
      <ProjectList projects={[{
        title: "How I built a 26 MB offline AI with Rust and Burn",
        href: `${base}blog/blog.html`,
        description: "How my bachelor project works, from the semi-supervised training to getting the model running offline on a phone.",
      }]} />
    </section>

    <footer {...stylex.attrs(portfolioStyles.pageFooter)}>
      <h2 {...stylex.attrs(portfolioStyles.footerHeading)}>Get in touch</h2>
      <p {...stylex.attrs(portfolioStyles.paragraph)}>If you have a role or a project in mind, email me at warresnaet@icloud.com.</p>
      <div {...stylex.attrs(portfolioStyles.contactRow)}>
        <button {...stylex.attrs(portfolioStyles.copyEmailButton)} type="button" data-copy-email>Copy email</button>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href="https://www.linkedin.com/in/warre-snaet-272354370/">LinkedIn</a>
      </div>
      <div {...stylex.attrs(portfolioStyles.footerMeta)}>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href={`${base}CV_Warre_Snaet_ATS.pdf`}>Download the ATS CV</a>
        <span>Warre Snaet, {year}</span>
      </div>
    </footer>
  </main>

  <div {...stylex.attrs(portfolioStyles.copyNotification)} id="copy-notification" role="status" aria-live="polite" aria-atomic="true" hidden></div>

  <script>
    const portfolioEmailAddress = "warresnaet@icloud.com";
    let copyNotificationDismissalTimer: number | undefined;

    const copyPortfolioEmailAddress = async (): Promise<boolean> => {
      try {
        if (!navigator.clipboard?.writeText) return false;

        await navigator.clipboard.writeText(portfolioEmailAddress);
        return true;
      } catch {
        return false;
      }
    };

    // Delegation also covers the new homepage DOM after client-side navigation.
    document.addEventListener("click", async (event) => {
        if (!(event.target instanceof Element) || !event.target.closest("[data-copy-email]")) return;
        const emailWasCopied = await copyPortfolioEmailAddress();

        const copyNotification = document.querySelector<HTMLDivElement>("#copy-notification");
        if (!copyNotification) return;

        copyNotification.textContent = emailWasCopied
          ? `Email address copied: ${portfolioEmailAddress}`
          : `Copy failed. Email address: ${portfolioEmailAddress}`;
        copyNotification.hidden = false;

        if (copyNotificationDismissalTimer !== undefined) {
          window.clearTimeout(copyNotificationDismissalTimer);
        }

        if (emailWasCopied) {
          copyNotificationDismissalTimer = window.setTimeout(() => {
            copyNotification.hidden = true;
          }, 5000);
        }
    });
  </script>
</BaseLayout>
