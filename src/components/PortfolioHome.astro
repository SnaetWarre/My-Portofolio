---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "./ProjectList.astro";
import TopLine from "./TopLine.astro";
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { portfolioStyles } from "../styles/portfolioStyles";
import StructuredData from "./StructuredData.astro";
import { gitDates, person, personId, profileLinks, siteUrl, website, websiteId } from "../lib/site";
import { experience, openSource, selectedWork, writing } from "../lib/projects";

interface Props { experimental?: boolean; }
const { experimental = false } = Astro.props;

const base = basePath;
const year = new Date().getFullYear();

const homeDates = gitDates("src/components/PortfolioHome.astro");
const structuredData = [
  {
    "@type": "ProfilePage",
    "@id": `${siteUrl}#profile`,
    url: siteUrl,
    name: "Warre Snaet | AI Engineer",
    inLanguage: "en",
    isPartOf: { "@id": websiteId },
    mainEntity: { "@id": personId },
    ...(homeDates && { dateCreated: homeDates.created, dateModified: homeDates.modified }),
  },
  person,
  website,
];
---

<BaseLayout
  experimental={experimental}
  title="Warre Snaet | AI Engineer"
  description="AI engineer from Belgium. Python backends, computer vision and machine learning. Physical AI engineer at Captic from November 2026."
>
  <Fragment slot="head">
    {!experimental && <meta name="google-site-verification" content="6eWn6i2uGzI9GNa1ChJIQHg27HSQm1WzUL74ts5Uf0E" />}
    <link rel="me" href={profileLinks.linkedIn} />
    <link rel="me" href={profileLinks.gitHub} />
    <StructuredData graph={structuredData} />
  </Fragment>
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#main">Skip to content</a>
  <div {...stylex.attrs(portfolioStyles.page)}>
    <TopLine home />

    <main {...stylex.attrs(portfolioStyles.column)} id="main" tabindex="-1">
      <section {...stylex.attrs(portfolioStyles.intro)}>
        <h1 {...stylex.attrs(portfolioStyles.introLine, portfolioStyles.introHeading)}>I'm Warre Snaet, an AI engineer from Vilvoorde, Belgium.</h1>
        <p {...stylex.attrs(portfolioStyles.introLine)}>In November&nbsp;2026 I start as a physical AI engineer at <a {...stylex.attrs(portfolioStyles.link)} href="https://captic.com">Captic</a>.</p>
        <p {...stylex.attrs(portfolioStyles.introLine)}>I graduated in AI Engineering at Howest, with distinction.</p>
        <div {...stylex.attrs(portfolioStyles.buttonRow)}>
          <button {...stylex.attrs(portfolioStyles.button)} type="button" data-copy-email>Copy email</button>
          <a {...stylex.attrs(portfolioStyles.button)} href={`${base}cv.html`}>Read my CV</a>
        </div>
      </section>

      <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="work">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="work">Work</h2>
        <ProjectList projects={experience} />
      </section>

      <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="projects">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="projects">Projects</h2>
        <ProjectList projects={selectedWork} />
      </section>

      <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="open-source">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="open-source">Open source</h2>
        <ProjectList projects={openSource} />
      </section>

      <section {...stylex.attrs(portfolioStyles.section)} aria-labelledby="writing">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="writing">Writing</h2>
        <ProjectList projects={writing} />
      </section>

      <footer {...stylex.attrs(portfolioStyles.section)} aria-labelledby="contact">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="contact">Contact</h2>
        <p {...stylex.attrs(portfolioStyles.introLine)}>If you have a question about any of this, send me an email at <a {...stylex.attrs(portfolioStyles.link)} href="mailto:warresnaet@icloud.com">warresnaet@icloud.com</a>.</p>
        <div {...stylex.attrs(portfolioStyles.buttonRow)}>
          <button {...stylex.attrs(portfolioStyles.button)} type="button" data-copy-email>Copy email</button>
          <a {...stylex.attrs(portfolioStyles.button)} href={profileLinks.linkedIn}>LinkedIn</a>
          <a {...stylex.attrs(portfolioStyles.button)} href={`${base}CV_Warre_Snaet_ATS.pdf`}>ATS CV (PDF)</a>
        </div>
        <p {...stylex.attrs(portfolioStyles.footnote)}>Warre Snaet, {year}</p>
      </footer>
    </main>
  </div>

  <div {...stylex.attrs(portfolioStyles.copyNotification)} id="copy-notification" role="status" aria-live="polite" aria-atomic="true" hidden></div>

  <script>
    const portfolioEmailAddress = "warresnaet@icloud.com";
    let copyNotificationDismissalTimer: number | undefined;

    const copyPortfolioEmailAddress = async (): Promise<boolean> => {
      try {
        if (!navigator.clipboard?.writeText) return false;
        await navigator.clipboard.writeText(portfolioEmailAddress);
        return true;
      } catch {
        return false;
      }
    };

    // Delegation also covers the new homepage DOM after client-side navigation.
    document.addEventListener("click", async (event) => {
      if (!(event.target instanceof Element) || !event.target.closest("[data-copy-email]")) return;
      const emailWasCopied = await copyPortfolioEmailAddress();

      const copyNotification = document.querySelector<HTMLDivElement>("#copy-notification");
      if (!copyNotification) return;

      copyNotification.textContent = emailWasCopied
        ? `Copied ${portfolioEmailAddress}`
        : `Copy failed. The address is ${portfolioEmailAddress}`;
      copyNotification.hidden = false;

      if (copyNotificationDismissalTimer !== undefined) {
        window.clearTimeout(copyNotificationDismissalTimer);
      }
      if (emailWasCopied) {
        copyNotificationDismissalTimer = window.setTimeout(() => {
          copyNotification.hidden = true;
        }, 4000);
      }
    });
  </script>
</BaseLayout>
