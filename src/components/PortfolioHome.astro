---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "./ProjectList.astro";
import TitleBlock from "./TitleBlock.astro";
import TopLine from "./TopLine.astro";
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { portfolioStyles } from "../styles/portfolioStyles";
import StructuredData from "./StructuredData.astro";
import { gitDates, person, personId, profileLinks, siteUrl, website, websiteId } from "../lib/site";
import { experience, openSource, selectedWork, writing } from "../lib/projects";

interface Props { experimental?: boolean; }
const { experimental = false } = Astro.props;

const base = basePath;
const year = new Date().getFullYear();

const homeDates = gitDates("src/components/PortfolioHome.astro");
const structuredData = [
  {
    "@type": "ProfilePage",
    "@id": `${siteUrl}#profile`,
    url: siteUrl,
    name: "Warre Snaet | Backend & Applied AI Engineer",
    inLanguage: "en",
    isPartOf: { "@id": websiteId },
    mainEntity: { "@id": personId },
    ...(homeDates && { dateCreated: homeDates.created, dateModified: homeDates.modified }),
  },
  person,
  website,
];
---

<BaseLayout
  experimental={experimental}
  title="Warre Snaet | Backend & Applied AI Engineer"
  description="Python backends, data pipelines and machine learning. Based in Belgium."
>
  <Fragment slot="head">
    {!experimental && <meta name="google-site-verification" content="6eWn6i2uGzI9GNa1ChJIQHg27HSQm1WzUL74ts5Uf0E" />}
    <link rel="me" href={profileLinks.linkedIn} />
    <link rel="me" href={profileLinks.gitHub} />
    <StructuredData graph={structuredData} />
  </Fragment>
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#main">Skip to content</a>
  <div {...stylex.attrs(portfolioStyles.page)}>
    <TopLine home />

    <header {...stylex.attrs(portfolioStyles.cover)}>
      <TitleBlock
        heading="Warre Snaet"
        tag="I build backends and applied AI, mostly in Python."
        cells={[
          { label: "Based in", value: "Vilvoorde, Belgium" },
          { label: "Works in", value: "Python, Rust" },
          { label: "Looking for", value: "A junior role" },
        ]}
      />
    </header>

    <main id="main" tabindex="-1">
      <section {...stylex.attrs(portfolioStyles.intro)} aria-labelledby="about-title">
        <div>
          <h2 {...stylex.attrs(portfolioStyles.visuallyHidden)} id="about-title">About</h2>
          <p {...stylex.attrs(portfolioStyles.lead)}>I'm Warre, a backend and applied AI engineer from Vilvoorde, Belgium. I studied AI Engineering at Howest and graduated with distinction.</p>
          <p {...stylex.attrs(portfolioStyles.paragraph, portfolioStyles.supportingText)}>I work mostly in Python, and also in Rust. I build APIs, data pipelines, computer vision and OCR, and machine learning, including reinforcement learning and generative AI. I also set up what it runs on, with AWS, Azure, Terraform, containers, Kubernetes and CI/CD.</p>
          <p {...stylex.attrs(portfolioStyles.paragraph, portfolioStyles.supportingText)}>I'm looking for a junior role in cloud, backend, software, data or applied AI engineering. Agent infrastructure and MLOps interest me most.</p>
          <div {...stylex.attrs(portfolioStyles.contactRow)}>
            <button {...stylex.attrs(portfolioStyles.copyEmailButton)} type="button" data-copy-email>Copy email</button>
            <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href={`${base}cv.html`}>Read my CV</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="work">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="work">Work</h2>
        <ProjectList projects={experience} />
      </section>

      <section aria-labelledby="projects">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="projects">Projects</h2>
        <ProjectList projects={selectedWork} />
      </section>

      <section aria-labelledby="open-source">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="open-source">Open source</h2>
        <ProjectList projects={openSource} />
      </section>

      <section aria-labelledby="writing">
        <h2 {...stylex.attrs(portfolioStyles.sectionHeading)} id="writing">Writing</h2>
        <ProjectList projects={writing} />
      </section>
    </main>

    <footer {...stylex.attrs(portfolioStyles.pageFooter)}>
      <div {...stylex.attrs(portfolioStyles.footerColumn)}>
        <h2 {...stylex.attrs(portfolioStyles.footerHeading)}>Get in touch</h2>
        <p {...stylex.attrs(portfolioStyles.paragraph)} style="margin: 0">If you have a role that fits, or a question about any of this, send me an email.</p>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.emailLink)} href="mailto:warresnaet@icloud.com">warresnaet@icloud.com</a>
        <div {...stylex.attrs(portfolioStyles.contactRow)}>
          <button {...stylex.attrs(portfolioStyles.copyEmailButton)} type="button" data-copy-email>Copy email</button>
          <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} href={profileLinks.linkedIn}>LinkedIn</a>
        </div>
      </div>
      <div {...stylex.attrs(portfolioStyles.footerAside)}>
        <a {...stylex.attrs(portfolioStyles.link)} href={`${base}CV_Warre_Snaet_ATS.pdf`}>Download the ATS CV</a>
        <br />
        <span>Warre Snaet, {year}</span>
      </div>
    </footer>
  </div>

  <div {...stylex.attrs(portfolioStyles.copyNotification)} id="copy-notification" role="status" aria-live="polite" aria-atomic="true" hidden></div>

  <script>
    const portfolioEmailAddress = "warresnaet@icloud.com";
    let copyNotificationDismissalTimer: number | undefined;

    const copyPortfolioEmailAddress = async (): Promise<boolean> => {
      try {
        if (!navigator.clipboard?.writeText) return false;
        await navigator.clipboard.writeText(portfolioEmailAddress);
        return true;
      } catch {
        return false;
      }
    };

    // Delegation also covers the new homepage DOM after client-side navigation.
    document.addEventListener("click", async (event) => {
      if (!(event.target instanceof Element) || !event.target.closest("[data-copy-email]")) return;
      const emailWasCopied = await copyPortfolioEmailAddress();

      const copyNotification = document.querySelector<HTMLDivElement>("#copy-notification");
      if (!copyNotification) return;

      copyNotification.textContent = emailWasCopied
        ? `Copied ${portfolioEmailAddress}`
        : `Copy failed. The address is ${portfolioEmailAddress}`;
      copyNotification.hidden = false;

      if (copyNotificationDismissalTimer !== undefined) {
        window.clearTimeout(copyNotificationDismissalTimer);
      }
      if (emailWasCopied) {
        copyNotificationDismissalTimer = window.setTimeout(() => {
          copyNotification.hidden = true;
        }, 4000);
      }
    });
  </script>
</BaseLayout>
