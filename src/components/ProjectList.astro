---
import * as stylex from "@stylexjs/stylex";
import type { Project } from "../lib/projects";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul {...stylex.attrs(portfolioStyles.projectList)} role="list">
  {projects.map((project) => (
    <li>
      <h3 {...stylex.attrs(portfolioStyles.rowHeading)}>
        <a {...stylex.attrs(portfolioStyles.rowLink)} href={project.href}>{project.title}</a>
      </h3>
      {project.context && <p {...stylex.attrs(portfolioStyles.rowRole)}>{project.context}</p>}
      <p {...stylex.attrs(portfolioStyles.rowText)}>{project.description}</p>
    </li>
  ))}
</ul>
