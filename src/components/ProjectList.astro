---
import * as stylex from "@stylexjs/stylex";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Project {
  title: string;
  href?: string;
  description: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul {...stylex.attrs(portfolioStyles.list)}>
  {projects.map((project) => (
    <li {...stylex.attrs(portfolioStyles.listItem, portfolioStyles.projectRow, !project.href && portfolioStyles.staticProjectRow)}>
      {project.href ? <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.primaryProjectLink)} href={project.href}>{project.title}</a> : <strong>{project.title}</strong>}
      <span {...stylex.attrs(portfolioStyles.projectDescription)}>
        : {project.description}
        {project.secondaryHref && <> <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.secondaryProjectLink)} href={project.secondaryHref}>{project.secondaryLabel}</a>.</>}
      </span>
    </li>
  ))}
</ul>
