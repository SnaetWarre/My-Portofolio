---
import * as stylex from "@stylexjs/stylex";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Project {
  title: string;
  href?: string;
  description: string;
  context?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul {...stylex.attrs(portfolioStyles.projectList)} role="list">
  {projects.map((project) => (
    <li {...stylex.attrs(portfolioStyles.projectRow)}>
      <h3 {...stylex.attrs(portfolioStyles.projectHeading)}>
        {project.href ? <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.primaryProjectLink)} href={project.href}>{project.title}</a> : project.title}
        {project.context && <span {...stylex.attrs(portfolioStyles.projectContext)}>{project.context}</span>}
      </h3>
      <p {...stylex.attrs(portfolioStyles.projectDescription)}>{project.description}</p>
    </li>
  ))}
</ul>
