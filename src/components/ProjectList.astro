---
interface Project {
  title: string;
  href?: string;
  description: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="work-list">
  {projects.map((project) => (
    <li class:list={["project-row", { "project-row--static": !project.href }]}>
      <article>
        <h3>
          {project.href
            ? <a href={project.href}>{project.title}<span aria-hidden="true">→</span></a>
            : project.title}
        </h3>
        <p>{project.description}</p>
      </article>
    </li>
  ))}
</ul>
