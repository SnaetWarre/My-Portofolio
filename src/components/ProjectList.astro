---
import * as stylex from "@stylexjs/stylex";
import Schematic from "./Schematic.astro";
import type { Project } from "../lib/projects";
import { portfolioStyles } from "../styles/portfolioStyles";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul {...stylex.attrs(portfolioStyles.projectList)} role="list">
  {projects.map((project) => {
    const aside = project.drawing?.placement === "aside";
    const below = project.drawing?.placement === "below";
    return (
      <li {...stylex.attrs(portfolioStyles.row, aside && portfolioStyles.rowAside)}>
        <div>
          <h3 {...stylex.attrs(portfolioStyles.rowHeading)}>
            <a {...stylex.attrs(portfolioStyles.rowLink)} href={project.href}>{project.title}</a>
            {project.context && <span {...stylex.attrs(portfolioStyles.rowRole)}>{project.context}</span>}
          </h3>
          <p {...stylex.attrs(portfolioStyles.rowText)}>{project.description}</p>
        </div>
        {aside && project.drawing && (
          <div {...stylex.attrs(portfolioStyles.drawingAside)}><Schematic drawing={project.drawing.key} /></div>
        )}
        {below && project.drawing && (
          <div {...stylex.attrs(portfolioStyles.drawingBelow)}><Schematic drawing={project.drawing.key} /></div>
        )}
      </li>
    );
  })}
</ul>
