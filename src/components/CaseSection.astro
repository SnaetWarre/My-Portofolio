---
import * as stylex from "@stylexjs/stylex";
import { caseStudyStyles } from "../styles/caseStudyStyles";

interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<section {...stylex.attrs(caseStudyStyles.section)}>
  <p {...stylex.attrs(caseStudyStyles.metadataLabel, caseStudyStyles.sectionLabel)}>{label}</p>
  <div>
    <h2 {...stylex.attrs(caseStudyStyles.sectionHeading)}>{title}</h2>
    <slot />
  </div>
</section>
