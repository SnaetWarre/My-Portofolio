---
import * as stylex from "@stylexjs/stylex";
import { portfolioStyles } from "../styles/portfolioStyles";
import { cvStyles } from "../styles/cvStyles";

interface Props {
  /** Match the boxed buttons of the CV toolbar. */
  boxed?: boolean;
}
const { boxed = false } = Astro.props;
---

<button {...stylex.attrs(boxed ? cvStyles.toolbarAction : portfolioStyles.navigationLink, portfolioStyles.textButton)} type="button" data-theme-toggle aria-pressed="false">Dark</button>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const systemTheme = matchMedia("(prefers-color-scheme: dark)");
  const storageKey = "portfolio-theme";
  const paper = { light: "#e6e5e1", dark: "#1b1c1e" };

  function effectiveTheme(): "light" | "dark" {
    if (root.dataset.theme === "dark") return "dark";
    if (root.dataset.theme === "light") return "light";
    return systemTheme.matches ? "dark" : "light";
  }

  function updateToggle() {
    const isDark = effectiveTheme() === "dark";
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isDark ? paper.dark : paper.light);
    if (!toggle) return;
    // The button names the theme it switches to.
    toggle.textContent = isDark ? "Light" : "Dark";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
  }

  function choose(theme: "light" | "dark") {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(storageKey, theme);
    } catch { /* The selection still works for this page. */ }
    updateToggle();
  }

  type SameDocumentTransition = { ready: Promise<void>; finished: Promise<void> };
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // The script re-runs after client-side navigation, so guard the listeners.
  const boundFlag = "__themeToggleBound";
  const alreadyBound = (window as Window & { [boundFlag]?: boolean })[boundFlag] === true;
  let wiping = false;

  function dipToTheme(next: "light" | "dark") {
    // No View Transitions API: cover in the current paper colour, swap
    // underneath, then fade back in.
    const veil = document.createElement("div");
    veil.setAttribute("aria-hidden", "true");
    veil.style.cssText = `position:fixed;inset:0;z-index:2147483646;background:${paper[effectiveTheme()]};opacity:0;pointer-events:none;transition:opacity 160ms ease-out;`;
    document.body.appendChild(veil);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      veil.style.opacity = "1";
      window.setTimeout(() => {
        choose(next);
        veil.style.transition = "opacity 320ms ease-out";
        veil.style.opacity = "0";
        window.setTimeout(() => veil.remove(), 360);
      }, 180);
    }));
  }

  function toggleTheme() {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    const doc = document as Document & {
      startViewTransition?: (update: () => void) => SameDocumentTransition;
    };
    if (reducedMotion.matches || !toggle || wiping) {
      choose(next);
      return;
    }
    if (!doc.startViewTransition) {
      dipToTheme(next);
      return;
    }
    // Aim the circular wipe at the button. CSS keyframes read these custom props.
    const rect = toggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    root.style.setProperty("--reveal-x", `${x}px`);
    root.style.setProperty("--reveal-y", `${y}px`);
    root.style.setProperty("--reveal-r", `${radius}px`);
    // Astro's ClientRouter gives some elements generated view-transition-names,
    // which would leave the default "root" snapshot empty. Fold every named
    // snapshot into one "theme-wipe" group for this toggle only.
    const renamed: Array<{ el: HTMLElement; prev: string }> = [];
    const rename = (el: Element, name: string) => {
      if (!(el instanceof HTMLElement)) return;
      renamed.push({ el, prev: el.style.getPropertyValue("view-transition-name") });
      el.style.setProperty("view-transition-name", name);
    };
    rename(root, "theme-wipe");
    for (const el of document.querySelectorAll("*")) {
      if (el !== root && getComputedStyle(el).viewTransitionName !== "none") rename(el, "none");
    }
    const restore = () => {
      for (const { el, prev } of renamed) el.style.setProperty("view-transition-name", prev);
    };
    wiping = true;
    try {
      const transition = doc.startViewTransition(() => choose(next));
      transition.finished.then(
        () => { wiping = false; restore(); },
        () => { wiping = false; restore(); },
      );
    } catch {
      wiping = false;
      restore();
      choose(next);
    }
  }

  if (!alreadyBound) {
    (window as Window & { [boundFlag]?: boolean })[boundFlag] = true;
    // Delegation keeps working after client-side navigation swaps the button.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-theme-toggle]")) toggleTheme();
    });
    systemTheme.addEventListener("change", updateToggle);
    window.addEventListener("storage", (event) => {
      if (event.key !== storageKey && event.key !== null) return;
      if (event.newValue === "light" || event.newValue === "dark") root.dataset.theme = event.newValue;
      else delete root.dataset.theme;
      updateToggle();
    });
    // Carry the current choice onto the incoming document before it paints.
    document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
      const incoming = event.newDocument.documentElement;
      if (root.dataset.theme) incoming.dataset.theme = root.dataset.theme;
      else delete incoming.dataset.theme;
    });
    document.addEventListener("astro:page-load", updateToggle);
  }
  updateToggle();
</script>
