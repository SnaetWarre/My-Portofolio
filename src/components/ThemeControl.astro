---
import * as stylex from "@stylexjs/stylex";
import ControlIcon from "./ControlIcon.astro";
import { obsidianStyles as styles } from "../styles/obsidianStyles";
---

<div {...stylex.attrs(styles.controlsHost)} data-theme-controls hidden transition:persist="appearance-controls" transition:animate="none">
  <div {...stylex.attrs(styles.themeControls)} role="group" aria-label="Appearance">
    <button {...stylex.attrs(styles.iconButton)} type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme" aria-pressed="false">
      <span data-icon-sun hidden><ControlIcon name="sun" /></span>
      <span data-icon-moon><ControlIcon name="moon" /></span>
    </button>
  </div>
</div>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const controls = document.querySelector<HTMLElement>("[data-theme-controls]");
  const systemTheme = matchMedia("(prefers-color-scheme: dark)");
  const storageKey = "portfolio-theme";

  function effectiveTheme(): "light" | "dark" {
    if (root.dataset.theme === "dark") return "dark";
    if (root.dataset.theme === "light") return "light";
    return systemTheme.matches ? "dark" : "light";
  }

  function updateToggle() {
    if (!toggle) return;
    const isDark = effectiveTheme() === "dark";
    const label = isDark ? "Switch to light theme" : "Switch to dark theme";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", label);
    toggle.title = label;
    const sun = toggle.querySelector<HTMLElement>("[data-icon-sun]");
    const moon = toggle.querySelector<HTMLElement>("[data-icon-moon]");
    // Show the action: sun in dark mode, moon in light mode.
    if (sun) sun.hidden = !isDark;
    if (moon) moon.hidden = isDark;
  }

  function choose(theme: "light" | "dark") {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(storageKey, theme);
    } catch { /* The selection still works for this page. */ }
    updateToggle();
  }

  type SameDocumentTransition = { ready: Promise<void>; finished: Promise<void> };
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // The button persists across Astro navigations while this script re-runs,
  // so guard against stacking duplicate listeners on the same element.
  const boundFlag = "__themeToggleBound";
  const alreadyBound =
    (window as Window & { [boundFlag]?: boolean })[boundFlag] === true;

  function toggleTheme() {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    const doc = document as Document & {
      startViewTransition?: (update: () => void) => SameDocumentTransition;
    };
    // Instant fallback: no API, reduced motion, or missing button.
    if (!doc.startViewTransition || reducedMotion.matches || !toggle) {
      choose(next);
      return;
    }
    // Aim the wipe at the button. CSS keyframes read these custom props,
    // so no WAAPI pseudo-element animation is required.
    const rect = toggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    root.style.setProperty("--reveal-x", `${x}px`);
    root.style.setProperty("--reveal-y", `${y}px`);
    root.style.setProperty("--reveal-r", `${radius}px`);
    try {
      doc.startViewTransition(() => choose(next));
    } catch {
      choose(next);
    }
  }

  if (!alreadyBound) {
    (window as Window & { [boundFlag]?: boolean })[boundFlag] = true;
    toggle?.addEventListener("click", toggleTheme);
    systemTheme.addEventListener("change", updateToggle);
    window.addEventListener("storage", (event) => {
      if (event.key !== storageKey && event.key !== null) return;
      if (event.newValue === "light" || event.newValue === "dark") root.dataset.theme = event.newValue;
      else delete root.dataset.theme;
      updateToggle();
    });
    // Apply the current choice to the incoming document before any new content paints.
    document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
      // Native transition snapshots can briefly hide a paused WebGL canvas.
      // Keep Astro's DOM swap and persistence, but show the live scene throughout.
      event.viewTransition.skipTransition();
      const incoming = event.newDocument.documentElement;
      if (root.dataset.theme) incoming.dataset.theme = root.dataset.theme;
      else delete incoming.dataset.theme;
    });
  }
  updateToggle();
  if (controls) controls.hidden = false;
</script>
