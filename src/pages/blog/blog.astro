---
import { basePath } from "../../lib/paths";
import ThemeSetup from "../../components/ThemeSetup.astro";
import ThemeControl from "../../components/ThemeControl.astro";
import ObsidianScene from "../../components/ObsidianScene.astro";
import SiteIcons from "../../components/SiteIcons.astro";
import SocialMetadata from "../../components/SocialMetadata.astro";
import { obsidianTheme } from "../../styles/obsidianStyles";
import * as stylex from "@stylexjs/stylex";
import StyleXDevStyles from "../../components/StyleXDevStyles.astro";
import { blogStyles } from "../../styles/blogStyles";
import { portfolioStyles } from "../../styles/portfolioStyles";
import "katex/dist/katex.min.css";
import "../../styles/reset.css";

const title = "Semi-supervised plant disease detection in Rust | Warre Snaet";
const description = "Building an offline plant disease classifier with Rust, the Burn ML framework, and a pseudo-labeling pipeline that triples usable training data.";
const canonical = new URL("/My-Portofolio/blog/blog.html", Astro.site);
---

<!doctype html>
<html transition:animate="none" lang="en" data-obsidian {...stylex.attrs(portfolioStyles.document, blogStyles.document, obsidianTheme)}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <SiteIcons />
        <ThemeSetup />
        <title>{title}</title>

        <!-- SEO Meta Tags -->
        <meta
            name="keywords"
            content="Rust, Burn Framework, Edge AI, Semi-Supervised Learning, Pseudo-Labeling, Tauri, ONNX, Plant Disease Detection, Machine Learning"
        />
        <meta name="author" content="Warre Snaet" />
        <meta name="robots" content="index, follow" />
        <SocialMetadata
            {title}
            {description}
            {canonical}
            type="article"
            imagePath="social/blog-rust.png"
            imageAlt="Semi-supervised plant disease detection in Rust, an engineering article by Warre Snaet"
        />

        <!-- Structured Data (JSON-LD) -->
        <script is:inline type="application/ld+json">
            [
                {
                    "@context": "https://schema.org",
                    "@type": "TechArticle",
                    "headline": "Semi-supervised plant disease detection in Rust",
                    "alternativeHeadline": "Building an offline ML pipeline with Burn, pseudo-labeling, and multi-platform deployment",
                    "image": "https://snaetwarre.github.io/My-Portofolio/social/blog-rust.png",
                    "author": {
                        "@type": "Person",
                        "name": "Warre Snaet",
                        "url": "https://snaetwarre.github.io/My-Portofolio/"
                    },
                    "genre": "Artificial Intelligence",
                    "keywords": "Rust, Burn Framework, Semi-Supervised Learning, Edge AI, Pseudo-Labeling, Tauri",
                    "wordcount": "2500",
                    "url": "https://snaetwarre.github.io/My-Portofolio/blog/blog.html",
                    "datePublished": "2026-01-21",
                    "dateModified": "2026-09-17",
                    "description": "How I built an offline plant disease detector in Rust with the Burn framework, trained it with semi-supervised pseudo-labeling, and deployed it to several platforms through Tauri and ONNX."
                },
                {
                    "@context": "https://schema.org",
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Home",
                            "item": "https://snaetwarre.github.io/My-Portofolio/"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "Blog",
                            "item": "https://snaetwarre.github.io/My-Portofolio/#writing-title"
                        },
                        {
                            "@type": "ListItem",
                            "position": 3,
                            "name": "Semi-supervised plant disease detection",
                            "item": "https://snaetwarre.github.io/My-Portofolio/blog/blog.html"
                        }
                    ]
                }
            ]
        </script>

        <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
        <link rel="alternate icon" href={`${basePath}favicon.ico`} />
        <StyleXDevStyles />
        <script>
            import renderMathInElement from "katex/contrib/auto-render";
            document.addEventListener("astro:page-load", function() {
                const article = document.querySelector<HTMLElement>("#article");
                if (!article) return;
                renderMathInElement(article, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\(', right: '\\)', display: false},
                        {left: '\\[', right: '\\]', display: true}
                    ],
                    throwOnError: false
                });
            });
        </script>
    </head>
    <body {...stylex.attrs(portfolioStyles.body)}>
        <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink, blogStyles.skipLink)} href="#article">Skip to article</a>

        <nav {...stylex.attrs(blogStyles.pageColumn, blogStyles.siteNavigation)} aria-label="Article navigation">
            <a href={`${basePath}index.html`} {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)}>Warre Snaet</a>
            <div {...stylex.attrs(blogStyles.navigationLinks)}>
                <a href={`${basePath}index.html#work-title`} {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)}>Work</a>
                <a href={`${basePath}blog/blog.html`} {...stylex.attrs(portfolioStyles.link, portfolioStyles.navigationLink)} aria-current="page">Writing</a>
            </div>
        </nav>

        <main {...stylex.attrs(blogStyles.blogPost, blogStyles.pageColumn)} id="article" tabindex="-1">
            <article>
                <header {...stylex.attrs(blogStyles.blogHeader)}>
                    <div {...stylex.attrs(blogStyles.metadata)}>
                        <span {...stylex.attrs(blogStyles.metadataItem)}>Jan 24, 2026</span>
                        <span {...stylex.attrs(blogStyles.metadataItem)}
                            >Rust / Burn / semi-supervised learning / edge AI</span
                        >
                    </div>
                    <h1 {...stylex.attrs(blogStyles.title)}>
                        Semi-supervised plant disease detection in Rust
                    </h1>
                </header>

                <div {...stylex.attrs(blogStyles.articleContent)}>
                    <!-- Key Stats Grid -->
                    <div {...stylex.attrs(blogStyles.statisticGrid)}>
                        <div {...stylex.attrs(blogStyles.statisticItem)}>
                            <span {...stylex.attrs(blogStyles.statisticNumber)}>~460K</span>
                            <span {...stylex.attrs(blogStyles.statisticLabel)}>Parameters</span>
                        </div>
                        <div {...stylex.attrs(blogStyles.statisticItem)}>
                            <span {...stylex.attrs(blogStyles.statisticNumber)}>38</span>
                            <span {...stylex.attrs(blogStyles.statisticLabel)}
                                >Disease classes</span
                            >
                        </div>
                        <div {...stylex.attrs(blogStyles.statisticItem)}>
                            <span {...stylex.attrs(blogStyles.statisticNumber)}>20%</span>
                            <span {...stylex.attrs(blogStyles.statisticLabel)}>Labeled data</span>
                        </div>
                        <div {...stylex.attrs(blogStyles.statisticItem)}>
                            <span {...stylex.attrs(blogStyles.statisticNumber)}>0.42ms</span>
                            <span {...stylex.attrs(blogStyles.statisticLabel)}
                                >Mean inference</span
                            >
                        </div>
                    </div>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        In my fifth semester at Howest I did a research project
                        with three goals. I wanted to build a complete machine
                        learning pipeline in Rust with the{" "}
                        <a
                            href="https://burn.dev"
                            target="_blank"
                            {...stylex.attrs(portfolioStyles.link, blogStyles.articleLink)}
                            >Burn framework</a
                        >, train a plant disease classifier on very little labeled
                        data using semi-supervised learning, and get it running
                        offline on desktop, in the browser, and on mobile.
                    </p>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The code, experiment outputs, and thesis documents are
                        in the{" "}
                        <a {...stylex.attrs(portfolioStyles.link, blogStyles.articleLink)} href="https://github.com/SnaetWarre/Research_Project_Rust_Semi-Supervised_Learning" target="_blank">public repository</a>.
                    </p>

                    <h2 {...stylex.attrs(blogStyles.articleSectionHeading)}>The problem</h2>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The users are farmers who need to recognize plant
                        diseases in places with poor or no internet. Getting an
                        expert or a lab to identify a disease can be slow and
                        expensive, and running the model in the cloud needs a
                        stable connection. In a lot of fields you can't count
                        on either.
                    </p>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>So the app had to:</p>
                    <ul {...stylex.attrs(blogStyles.articleList)}>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>work 100% offline</li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            run on devices farmers already own (phones,
                            laptops)
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            install without any hassle (farmers are not
                            sysadmins)
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>return a result in under a second, so the feedback feels immediate</li>
                    </ul>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Labeled agricultural data is also expensive. Expert
                        annotation costs about &euro;2 per image, so 50,000
                        images would cost &euro;100K, which we don't have. The
                        pipeline has to learn well from a small labeled
                        subset.
                    </p>

                    <hr {...stylex.attrs(blogStyles.articleRule)} />

                    <h2 {...stylex.attrs(blogStyles.articleSectionHeading)}>Why Rust and Burn</h2>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        I chose Rust and{" "}
                        <a
                            href="https://github.com/tracel-ai/burn"
                            target="_blank"
                            {...stylex.attrs(portfolioStyles.link, blogStyles.articleLink)}
                            >Burn</a
                        >{" "}
                        (v0.20.0-pre) because what this project needed lines up
                        well with what Rust is good at.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>One binary to ship</h3>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Burn compiles to a single binary with no external
                        runtime dependencies. With LTO and
                        <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>codegen-units = 1</code> in the release profile,
                        the model and the inference runtime ship as one file.
                        There's no virtual environment, package manager, or
                        install step, which matters when your users are farmers
                        who are never going to run <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>pip install</code>, this matters.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Several backends, one codebase</h3>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Burn supports multiple compute backends through Rust's
                        trait system:
                    </p>
                    <ul {...stylex.attrs(blogStyles.articleList)}>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>burn-cuda</code> for native CUDA (desktop GPU
                            training and inference)
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>burn-wgpu</code> for cross-platform GPU via
                            Vulkan, Metal, and DX12
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>burn-ndarray</code> as a CPU-only fallback with no
                            dependencies
                        </li>
                    </ul>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The same model definition compiles for all of them and
                        uses the same weights, and everything from training to
                        production is written in one language.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Fast startup</h3>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Burn loads in under 100ms. People expect a phone app to
                        respond right away, so startup time matters as much as
                        inference time.
                    </p>

                    <hr {...stylex.attrs(blogStyles.articleRule)} />

                    <h2 {...stylex.attrs(blogStyles.articleSectionHeading)}>Model architecture</h2>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The classifier is a small CNN with four convolutional
                        blocks and about 460,000 parameters:
                    </p>

                    <pre {...stylex.attrs(blogStyles.monospace, blogStyles.codeBlock)}><code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode, blogStyles.codeInsideBlock)}>Input: [B, 3, 128, 128]

Conv2d(3, 32, 3x3, pad=same)   -> BatchNorm -> ReLU -> MaxPool(2x2)
Conv2d(32, 64, 3x3, pad=same)  -> BatchNorm -> ReLU -> MaxPool(2x2)
Conv2d(64, 128, 3x3, pad=same) -> BatchNorm -> ReLU -> MaxPool(2x2)
Conv2d(128, 256, 3x3, pad=same)-> BatchNorm -> ReLU -> MaxPool(2x2)

AdaptiveAvgPool2d(1x1) -> Flatten
Linear(256, 256) -> ReLU -> Dropout(0.3)
Linear(256, 38)

Output: [B, 38] logits</code></pre>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Inputs are 128x128 RGB images, normalized with the
                        ImageNet statistics (mean = [0.485, 0.456, 0.406], std =
                        [0.229, 0.224, 0.225]). The 38 outputs are the plant disease classes from the
                        PlantVillage dataset.
                    </p>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>B: Backend</code> trait bound makes the model generic over
                        the backend, so this one struct compiles to CUDA, CPU,
                        or wgpu without any duplicated code:
                    </p>

                    <pre {...stylex.attrs(blogStyles.monospace, blogStyles.codeBlock)}><code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode, blogStyles.codeInsideBlock)}>#[derive(Module, Debug)]
pub struct PlantClassifier&lt;B: Backend&gt; &lbrace;
    conv1: Conv2d&lt;B&gt;,
    bn1: BatchNorm&lt;B, 2&gt;,
    conv2: Conv2d&lt;B&gt;,
    bn2: BatchNorm&lt;B, 2&gt;,
    conv3: Conv2d&lt;B&gt;,
    bn3: BatchNorm&lt;B, 2&gt;,
    conv4: Conv2d&lt;B&gt;,
    bn4: BatchNorm&lt;B, 2&gt;,
    fc1: Linear&lt;B&gt;,
    fc2: Linear&lt;B&gt;,
&rbrace;</code></pre>

                    <hr {...stylex.attrs(blogStyles.articleRule)} />

                    <h2 {...stylex.attrs(blogStyles.articleSectionHeading)}>The semi-supervised pipeline</h2>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        This is the main part of the project. Only 20% of the
                        data had labels, so I needed a way to use the other
                        80%. I went with iterative pseudo-labeling, also called
                        self-training.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Splitting the data</h3>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The ~87,000 PlantVillage images are split with
                        stratification:
                    </p>

                    <pre {...stylex.attrs(blogStyles.monospace, blogStyles.codeBlock)}><code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode, blogStyles.codeInsideBlock)}>Total dataset (~87K images)
  |-- Test set:       10% (~8.7K)   -- never seen during training
  |-- Validation set: 10% (~8.7K)   -- for monitoring and early stopping
  |-- Remaining:      80% (~69.6K)
       |-- Labeled pool:  20% (~13.9K)  -- used for supervised training
       |-- Stream pool:   80% (~55.7K)  -- unlabeled, used for SSL</code></pre>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Pseudo-labeling</h3>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        You train a model on the labeled data, use it to label
                        the rest, and retrain on the bigger set. Whether that
                        works or slowly fills the training set with noise
                        depends on the details.
                    </p>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>For each unlabeled sample $x_u$, the model produces:</p>
                    $$p = \text&lbrace;softmax&rbrace;(f(x_u))$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The predicted class and its confidence are:
                    </p>

                    $$\hat&lbrace;y&rbrace; = \arg\max(p), \quad c = \max(p)$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        A pseudo-label is only accepted when the confidence
                        reaches a threshold $\tau$:
                    </p>

                    $$c \geq \tau \quad (\tau = 0.9)$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        A 90% threshold is strict on purpose, because
                        low-confidence predictions poison the training set. The
                        final evaluation didn't separately measure how many
                        pseudo-labels were correct, so read the threshold as a
                        setting in the pipeline, not as a result.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Loss function</h3>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        For labeled data, the loss is standard cross-entropy:
                    </p>

                    $$\mathcal&lbrace;L&rbrace;_&lbrace;\text&lbrace;labeled&rbrace;&rbrace; = -\frac&lbrace;1&rbrace;&lbrace;N&rbrace;\sum_&lbrace;i=1&rbrace;^&lbrace;N&rbrace; \log\left(\text&lbrace;softmax&rbrace;(f(x_i))_&lbrace;y_i&rbrace;\right)$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Pseudo-labeled data uses a negative log-likelihood
                        weighted by confidence. Each sample counts in
                        proportion to how confident the model was when it made
                        that pseudo-label:
                    </p>

                    $$\mathcal&lbrace;L&rbrace;_&lbrace;\text&lbrace;pseudo&rbrace;&rbrace; = \frac&lbrace;\sum_&lbrace;i=1&rbrace;^&lbrace;M&rbrace; w_i \cdot \left(-\log\left(\text&lbrace;softmax&rbrace;(f(x_i))_&lbrace;\hat&lbrace;y&rbrace;_i&rbrace;\right)\right)&rbrace;&lbrace;\sum_&lbrace;i=1&rbrace;^&lbrace;M&rbrace; w_i + \epsilon&rbrace;$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        where $w_i$ is the confidence score of pseudo-label
                        $i$ and $\epsilon = 10^&lbrace;-8&rbrace;$ prevents division by zero.
                    </p>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>The total loss adds the two, with a ramp-up on the pseudo-label term:</p>

                    $$\mathcal&lbrace;L&rbrace;_&lbrace;\text&lbrace;total&rbrace;&rbrace; = \mathcal&lbrace;L&rbrace;_&lbrace;\text&lbrace;labeled&rbrace;&rbrace; + \lambda \cdot \text&lbrace;ramp&rbrace;(t) \cdot \mathcal&lbrace;L&rbrace;_&lbrace;\text&lbrace;pseudo&rbrace;&rbrace;$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The ramp-up raises the pseudo-label weight linearly over
                        the first $T_&lbrace;\text&lbrace;ramp&rbrace;&rbrace;$ epochs:
                    </p>

                    $$\text&lbrace;ramp&rbrace;(t) = \min\left(\frac&lbrace;t&rbrace;&lbrace;T_&lbrace;\text&lbrace;ramp&rbrace;&rbrace;&rbrace;, 1\right), \quad T_&lbrace;\text&lbrace;ramp&rbrace;&rbrace; = 10$$

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Early in training the predictions are still unreliable,
                        and this keeps the pseudo-labels from taking over
                        before the model is ready.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Simulating deployment</h3>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The SSL pipeline simulates new images arriving every
                        day, the way they would if a farmer kept photographing
                        their crops:
                    </p>

                    <ol {...stylex.attrs(blogStyles.articleList)}>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Train on the 20% labeled pool first, with
                            cross-entropy and Adam (lr = 0.0001, weight decay =
                            1e-4).
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Each simulated day, run inference on a batch of 100
                            images from the stream pool.
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Keep predictions with a confidence of at least
                            $\tau = 0.9$, capped at 500 pseudo-labels per class
                            so the classes stay balanced.
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Collect them in a buffer until it reaches the
                            retraining threshold (200-500 samples).
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Retrain on the labeled data plus the collected
                            pseudo-labels, with augmentation applied on the
                            fly.
                        </li>
                        <li {...stylex.attrs(blogStyles.articleListItem)}>
                            Repeat until the stream pool is empty.
                        </li>
                    </ol>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Inference runs on clean, unaugmented images, so the
                        pseudo-labels come from clean predictions. Retraining
                        does use augmentation, to prevent overfitting:
                        horizontal flips (p=0.5), rotation up to 20 degrees
                        (p=0.5), brightness and contrast jitter (p=0.5), and
                        light Gaussian noise (p=0.1). I wrote all of it from
                        scratch in Rust, without an image augmentation
                        library.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Results</h3>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        Both models started from the same 20% of labeled data
                        and were tested on the same held-out split of 8,786
                        images. The saved SSL checkpoint did a lot better than
                        the saved supervised baseline:
                    </p>

                    <table {...stylex.attrs(blogStyles.monospace, blogStyles.table)}>
                        <thead>
                            <tr {...stylex.attrs(blogStyles.tableRow)}>
                                <th {...stylex.attrs(blogStyles.tableCell, blogStyles.tableHeading)}>Metric</th>
                                <th {...stylex.attrs(blogStyles.tableCell, blogStyles.tableHeading)}>Supervised only</th>
                                <th {...stylex.attrs(blogStyles.tableCell, blogStyles.tableHeading)}>After SSL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr {...stylex.attrs(blogStyles.tableRow)}>
                                <td {...stylex.attrs(blogStyles.tableCell)}>Held-out top-1 accuracy</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}>86.06%</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}><strong>94.90%</strong></td>
                            </tr>
                            <tr {...stylex.attrs(blogStyles.tableRow)}>
                                <td {...stylex.attrs(blogStyles.tableCell)}>Held-out macro F1</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}>86.08%</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}><strong>94.74%</strong></td>
                            </tr>
                            <tr {...stylex.attrs(blogStyles.tableRow)}>
                                <td {...stylex.attrs(blogStyles.tableCell)}>Held-out test images</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}>8,786</td>
                                <td {...stylex.attrs(blogStyles.tableCell)}><strong>8,786</strong></td>
                            </tr>
                        </tbody>
                    </table>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        That's 8.84 percentage points more accuracy and 8.66
                        points more macro F1. The numbers come from one saved
                        split and one random seed. PlantVillage images are
                        fairly uniform and look like they were taken in a lab,
                        so don't expect the same performance out in a real
                        field.
                    </p>

                    <hr {...stylex.attrs(blogStyles.articleRule)} />

                    <h2 {...stylex.attrs(blogStyles.articleSectionHeading)}>Deployment</h2>

                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        There are three deployment targets, and they don't all
                        work the same way.
                    </p>

                    <h3 {...stylex.attrs(blogStyles.articleSubheading)}>Desktop: Tauri v2 + SvelteKit</h3>
                    <p {...stylex.attrs(blogStyles.articleParagraph)}>
                        The desktop application uses{" "}
                        <a
                            href="https://tauri.app"
                            target="_blank"
                            {...stylex.attrs(portfolioStyles.link, blogStyles.articleLink)}
                            >Tauri v2</a
                        >{" "}
                        with a SvelteKit 5 frontend and a Rust backend. The
                        backend exposes more than 30 Tauri commands that connect
                        the Svelte UI straight to GPU operations, so it does a
                        lot more than wrap a webview. Training runs inside
                        <code {...stylex.attrs(blogStyles.monospace, blogStyles.inlineCode)}>tokio::task::spawn_blocking</code> and sends events to the frontend as it goes, so the GUI
                        can show training progress, confidence distributions,
                        and benchmark results live.
                    </p>

                    <div {...stylex.attrs(blogStyles.imageWrapper)}>
                        <img
                            src={`${basePath}blog/images/dashboard-gui.png`}
