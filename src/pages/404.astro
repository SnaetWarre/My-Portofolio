---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopLine from "../components/TopLine.astro";
import { basePath } from "../lib/paths";
import { portfolioStyles } from "../styles/portfolioStyles";
import * as stylex from "@stylexjs/stylex";

const base = basePath;
---

<BaseLayout
  title="Page not found | Warre Snaet"
  description="This page doesn't exist. Go back to Warre Snaet's portfolio or look through the work."
  experimental
>
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#not-found">Skip to message</a>
  <div {...stylex.attrs(portfolioStyles.page)}>
    <TopLine trail={[{ label: "not found" }]} />
    <main {...stylex.attrs(portfolioStyles.column, portfolioStyles.intro)} id="not-found" tabindex="-1">
      <h1 {...stylex.attrs(portfolioStyles.introLine, portfolioStyles.introHeading)}>There's nothing at this address.</h1>
      <p {...stylex.attrs(portfolioStyles.introLine)}>The page may have moved, or the link was wrong.</p>
      <div {...stylex.attrs(portfolioStyles.buttonRow)}>
        <a {...stylex.attrs(portfolioStyles.button)} href={base}>Home page</a>
        <a {...stylex.attrs(portfolioStyles.button)} href={`${base}#work`}>See the work</a>
        <a {...stylex.attrs(portfolioStyles.button)} href={`${base}cv.html`}>Read my CV</a>
      </div>
    </main>
  </div>
</BaseLayout>
