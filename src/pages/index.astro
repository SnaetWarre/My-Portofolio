---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import { basePath } from "../lib/paths";

const base = basePath;
const year = new Date().getFullYear();

const experience = [
  {
    title: "AI & software engineering intern, 2Ai IPCA",
    href: `${base}work/medical-imaging.html`,
    description: "International internship using real clinical imaging data. I built a Python DICOM/OCR pipeline, validation and review tools, resumable batch processing, ECG extraction, and a source-video matcher. Metadata-guided alignment reduced one representative run from about 21 hours to 23 minutes.",
  },
  {
    title: "Software engineer, Apolloon 24-hour run system",
    href: `${base}work/apolloon.html`,
    description: "Paid client work. I designed and implemented a local-first race operations platform with realtime synchronisation, automatic LAN discovery, SQLite replication, and failover for unreliable event conditions.",
  },
];

const selectedWork = [
  {
    title: "AWS Fargate infrastructure with Vault workload identity",
    href: `${base}work/aws-fargate-vault.html`,
    description: "A tested Terraform architecture for private ECS Fargate workloads behind an ALB, with two-AZ networking, IAM-based Vault authentication, CloudWatch observability, autoscaling, health checks, and deployment safeguards.",
  },
  {
    title: "Financial AI agent",
    href: `${base}work/financial-agent.html`,
    description: "A six-service application with FastAPI streaming, MCP tool execution, RAG, PostgreSQL, React, ChromaDB, and local Ollama inference. In this two-person academic project, I owned the backend architecture, orchestration, persistence, containers, tests, and most frontend integration.",
  },
  {
    title: "Azure ML lifecycle",
    href: `${base}work/azure-mlops.html`,
    description: "Individual MLOps coursework covering Azure ML compute, parallel data preparation, model registration, MLflow, FastAPI, Docker, Kubernetes manifests, and GitHub Actions.",
  },
  {
    title: "Semi-supervised learning in Rust",
    href: `${base}blog/blog.html`,
    description: "Bachelor research into data-efficient plant-disease classification on edge devices. The saved SSL checkpoint reached 94.90% held-out accuracy and shipped as an approximately 26 MB offline application tested on iPhone.",
  },
  {
    title: "Event chatbot for XPO Group",
    href: `${base}work/xpo-chatbot.html`,
    description: "Academic team project for an external client: a full-stack RAG system using Azure OpenAI, Cosmos DB, .NET, Next.js, and Python ingestion.",
  },
  {
    title: "Dataset query system",
    href: `${base}work/dataset-query.html`,
    description: "A Python client-server analysis application with authentication, moderation, statistics, broadcasts, and a PySide6 interface.",
  },
];

const openSource = [
  {
    title: "Athas code editor · Maintainer & contributor",
    href: `${base}work/athas.html`,
    description: "I contribute across its React/TypeScript and Tauri/Rust codebase. Merged work includes C# language support, image diffing, Linux UI improvements, dynamic proxy ports, resource- and memory-leak fixes, and an LSP race-condition fix.",
  },
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Warre Snaet",
    jobTitle: "Junior Backend and Applied AI Engineer",
    url: "https://snaetwarre.github.io/My-Portofolio/",
    sameAs: ["https://www.linkedin.com/in/warre-snaet-272354370/", "https://github.com/SnaetWarre"],
    alumniOf: { "@type": "EducationalOrganization", name: "Howest University of Applied Sciences" },
  },
};
---

<BaseLayout
  title="Warre Snaet | Backend & Applied AI Engineer"
  description="Warre Snaet is an AI Engineering graduate with distinction from Belgium, building dependable Python backends, agent infrastructure, applied AI systems, and data pipelines."
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(profileSchema)} /></Fragment>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-name" href={base} aria-label="Warre Snaet, home">Warre Snaet</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#experience-title">Experience</a>
        <a href="#work-title">Work</a>
        <a href="#open-source-title">Open source</a>
        <a href={`${base}cv.html`}>CV</a>
        <a href="mailto:warresnaet@icloud.com">Contact</a>
      </nav>
    </div>
  </header>

  <main class="portfolio-main" id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="hero__eyebrow">Backend & applied AI engineer</p>
        <h1 id="hero-title">I build dependable software for complex systems.</h1>
        <p class="hero__introduction">I work across Python backends, data pipelines, applied machine learning, agent infrastructure, and cloud delivery. My focus is the engineering that makes AI and operational software reliable outside a demo.</p>
        <div class="hero__actions">
          <a class="primary-action" href={`${base}CV_Warre_Snaet_ATS.pdf`}>Download my CV</a>
          <a class="secondary-action" href="mailto:warresnaet@icloud.com">Send an email</a>
        </div>
      </div>

      <dl class="hero__details">
        <div>
          <dt>Based in</dt>
          <dd>Belgium</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>AI Engineering at Howest, with distinction</dd>
        </div>
        <div>
          <dt>Current focus</dt>
          <dd>Backend, cloud, data, applied AI, and MLOps roles</dd>
        </div>
      </dl>
    </section>

    <section class="chapter chapter--first" aria-labelledby="experience-title">
      <div class="chapter__heading">
        <p class="chapter__index">01</p>
        <h2 id="experience-title">Experience</h2>
        <p class="chapter__summary">Client work and an international internship where software had to work with real constraints and real data.</p>
      </div>
      <ProjectList projects={experience} />
    </section>

    <div class="chapter-band">
      <section class="chapter" aria-labelledby="work-title">
        <div class="chapter__heading">
          <p class="chapter__index">02</p>
          <h2 id="work-title">Selected work</h2>
          <p class="chapter__summary">Systems work across cloud infrastructure, AI applications, data platforms, and edge deployment.</p>
        </div>
        <ProjectList projects={selectedWork} />
      </section>
    </div>

    <div class="closing-grid">
      <section class="closing-section" aria-labelledby="open-source-title">
        <h2 id="open-source-title">Open source</h2>
        <p>Contributions maintained in a shared product and reviewed in public.</p>
        <ProjectList projects={openSource} />
      </section>

      <section class="closing-section" aria-labelledby="writing-title">
        <h2 id="writing-title">Writing</h2>
        <p>A technical breakdown of my Rust research project, from semi-supervised training to offline deployment.</p>
        <a class="writing-link" href={`${base}blog/blog.html`}>How I built a 26 MB offline AI with Rust and Burn&nbsp;→</a>
      </section>
    </div>
  </main>

  <div class="site-footer-band">
    <footer class="site-footer">
      <div>
        <p class="site-footer__lead">Open to junior engineering roles where reliability matters.</p>
        <a class="primary-action secondary-action" href="mailto:warresnaet@icloud.com">warresnaet@icloud.com</a>
      </div>
      <div class="site-footer__links">
        <a href="https://www.linkedin.com/in/warre-snaet-272354370/">LinkedIn ↗</a>
        <a href="https://github.com/SnaetWarre">GitHub ↗</a>
        <a href={`${base}cv.html`}>View CV</a>
        <a href={`${base}CV_Warre_Snaet_ATS.pdf`}>Download ATS CV</a>
      </div>
      <p class="site-footer__meta"><span>Warre Snaet, {year}</span><span>Backend & applied AI engineer · Belgium</span></p>
    </footer>
  </div>
</BaseLayout>
