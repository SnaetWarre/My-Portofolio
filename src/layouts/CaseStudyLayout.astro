---
import BaseLayout from "./BaseLayout.astro";
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { caseStudyStyles } from "../styles/caseStudyStyles";
import { portfolioStyles } from "../styles/portfolioStyles";

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  lead: string;
  meta: MetaItem[];
}

const { title, description, kicker, heading, lead, meta } = Astro.props;
const base = basePath;
---

<BaseLayout {title} {description}>
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#case-content">Skip to case study</a>
  <main {...stylex.attrs(caseStudyStyles.mainContent)} id="case-content">
    <nav {...stylex.attrs(portfolioStyles.navigation, caseStudyStyles.navigation)} aria-label="Case study navigation">
      <a {...stylex.attrs(portfolioStyles.link)} href={base}>← Warre Snaet</a>
      <a {...stylex.attrs(portfolioStyles.link)} href={`${base}#work-title`}>Selected work</a>
    </nav>

    <header {...stylex.attrs(caseStudyStyles.header)}>
      <div>
        <p {...stylex.attrs(caseStudyStyles.metadataLabel, caseStudyStyles.kicker)}>{kicker}</p>
        <h1 {...stylex.attrs(caseStudyStyles.heading)}>{heading}</h1>
        <p {...stylex.attrs(caseStudyStyles.lead)}>{lead}</p>
      </div>
      <dl {...stylex.attrs(caseStudyStyles.metadataList)}>
        {meta.map((metadataItem) => (
          <div {...stylex.attrs(caseStudyStyles.metadataRow)}>
            <dt {...stylex.attrs(caseStudyStyles.metadataLabel, caseStudyStyles.metadataTerm)}>{metadataItem.label}</dt>
            <dd {...stylex.attrs(caseStudyStyles.metadataDescription)}>{metadataItem.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <slot />

    <footer {...stylex.attrs(caseStudyStyles.footer)}><a {...stylex.attrs(portfolioStyles.link)} href={`${base}#work-title`}>← Back to selected work</a></footer>
  </main>
</BaseLayout>
