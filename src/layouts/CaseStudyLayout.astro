---
import BaseLayout from "./BaseLayout.astro";
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { caseStudyStyles } from "../styles/caseStudyStyles";
import { portfolioStyles } from "../styles/portfolioStyles";
import StructuredData from "../components/StructuredData.astro";
import PageEnd from "../components/PageEnd.astro";
import Schematic from "../components/Schematic.astro";
import TitleBlock from "../components/TitleBlock.astro";
import TopLine from "../components/TopLine.astro";
import type { DrawingKey } from "../lib/drawings";
import { absoluteUrl, breadcrumbs, gitDates, person, personId, website, websiteId } from "../lib/site";

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  lead: string;
  meta: MetaItem[];
}

/** The drawing at the top of each project page. */
const drawingForPage: Record<string, DrawingKey> = {
  "medical-imaging": "medicalImaging",
  apolloon: "apolloon",
  "aws-fargate-vault": "awsFargateVault",
  "financial-agent": "financialAgent",
  "azure-mlops": "azureMlops",
  "xpo-chatbot": "xpoChatbot",
  "dataset-query": "datasetQuery",
  athas: "athas",
};

const { title, description, kicker, heading, lead, meta } = Astro.props;
const base = basePath;
const slug = Astro.url.pathname.split("/").at(-1)?.replace(/\.html$/, "") ?? "work";
const drawing = drawingForPage[slug];
const socialImage = `social/${slug}.png`;
const socialImageAlt = `${heading}, an engineering case study by Warre Snaet`;
const pageUrl = absoluteUrl(`work/${slug}.html`);
const dates = gitDates(`src/pages/work/${slug}.astro`);
const structuredData = [
  {
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    headline: heading,
    description,
    image: absoluteUrl(socialImage),
    inLanguage: "en",
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
    ...(dates && { datePublished: dates.created, dateModified: dates.modified }),
  },
  breadcrumbs([
    { name: "Warre Snaet", path: "" },
    { name: heading, path: `work/${slug}.html` },
  ]),
  person,
  website,
];
---

<BaseLayout {title} {description} {socialImage} {socialImageAlt} socialType="article">
  <StructuredData slot="head" graph={structuredData} />
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#case-content">Skip to case study</a>
  <div {...stylex.attrs(portfolioStyles.page)}>
    <TopLine />

    <header {...stylex.attrs(portfolioStyles.cover)}>
      {drawing && (
        <div {...stylex.attrs(caseStudyStyles.drawing)}>
          <Schematic drawing={drawing} size="lead" />
        </div>
      )}
      <TitleBlock heading={heading} tag={kicker} cells={meta} />
    </header>

    <main {...stylex.attrs(caseStudyStyles.mainContent)} id="case-content" tabindex="-1">
      <p {...stylex.attrs(caseStudyStyles.lead)}>{lead}</p>
      <slot />
      <PageEnd href={`${base}work/${slug}.html`} />
    </main>
  </div>
</BaseLayout>
