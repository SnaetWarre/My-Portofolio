---
import BaseLayout from "./BaseLayout.astro";
import * as stylex from "@stylexjs/stylex";
import { basePath } from "../lib/paths";
import { caseStudyStyles } from "../styles/caseStudyStyles";
import { portfolioStyles } from "../styles/portfolioStyles";
import StructuredData from "../components/StructuredData.astro";
import PageEnd from "../components/PageEnd.astro";
import TopLine from "../components/TopLine.astro";
import { absoluteUrl, breadcrumbs, gitDates, person, personId, website, websiteId } from "../lib/site";

interface MetaItem {
  label: string;
  value: string;
  /** Links the value. */
  href?: string;
  /** Plain text after a linked value. */
  suffix?: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  lead: string;
  meta: MetaItem[];
}

const { title, description, kicker, heading, lead, meta } = Astro.props;
const base = basePath;
const slug = Astro.url.pathname.split("/").at(-1)?.replace(/\.html$/, "") ?? "work";
const socialImage = `social/${slug}.png`;
const socialImageAlt = `${heading}, an engineering case study by Warre Snaet`;
const pageUrl = absoluteUrl(`work/${slug}.html`);
const dates = gitDates(`src/pages/work/${slug}.astro`);
const structuredData = [
  {
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    headline: heading,
    description,
    image: absoluteUrl(socialImage),
    inLanguage: "en",
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
    ...(dates && { datePublished: dates.created, dateModified: dates.modified }),
  },
  breadcrumbs([
    { name: "Warre Snaet", path: "" },
    { name: heading, path: `work/${slug}.html` },
  ]),
  person,
  website,
];
---

<BaseLayout {title} {description} {socialImage} {socialImageAlt} socialType="article">
  <StructuredData slot="head" graph={structuredData} />
  <a {...stylex.attrs(portfolioStyles.link, portfolioStyles.skipLink)} href="#case-content">Skip to case study</a>
  <div {...stylex.attrs(portfolioStyles.page)}>
    <TopLine trail={[{ label: "work", href: `${base}#work` }, { label: slug.replaceAll("-", " ") }]} />

    <main {...stylex.attrs(portfolioStyles.column)} id="case-content" tabindex="-1">
      <header {...stylex.attrs(portfolioStyles.intro)}>
        <h1 {...stylex.attrs(caseStudyStyles.heading)}>{heading}</h1>
        <p {...stylex.attrs(caseStudyStyles.kicker)}>{kicker}</p>
        <dl {...stylex.attrs(caseStudyStyles.facts)}>
          {meta.map((item) => (
            <div {...stylex.attrs(caseStudyStyles.factRow)}>
              <dt {...stylex.attrs(caseStudyStyles.factLabel)}>{item.label}</dt>
              <dd {...stylex.attrs(caseStudyStyles.factValue)}>{item.href ? <a {...stylex.attrs(portfolioStyles.link)} href={item.href}>{item.value}</a> : item.value}{item.suffix}</dd>
            </div>
          ))}
        </dl>
      </header>
      <p {...stylex.attrs(caseStudyStyles.lead)}>{lead}</p>
      <slot />
      <PageEnd href={`${base}work/${slug}.html`} />
    </main>
  </div>
</BaseLayout>
