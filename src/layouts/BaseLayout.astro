---
import "../styles/reset.css";
import ThemeSetup from "../components/ThemeSetup.astro";
import ObsidianScene from "../components/ObsidianScene.astro";
import ThemeControl from "../components/ThemeControl.astro";
import SiteIcons from "../components/SiteIcons.astro";
import FontPreload from "../components/FontPreload.astro";
import SocialMetadata from "../components/SocialMetadata.astro";
import * as stylex from "@stylexjs/stylex";
import StyleXDevStyles from "../components/StyleXDevStyles.astro";
import { portfolioStyles } from "../styles/portfolioStyles";
import { obsidianTheme } from "../styles/obsidianStyles";
import { basePath } from "../lib/paths";

interface Props {
  experimental?: boolean;
  sculpture?: boolean;
  /** Which form the sculpture takes on this page. See scripts/obsidianPoses. */
  pose?: string;
  title: string;
  description: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialType?: "website" | "article";
}

const {
  title,
  description,
  experimental = false,
  sculpture = false,
  pose = "home",
  socialImage = "social/home-v3.png",
  socialImageAlt = "Warre Snaet, Backend and Applied AI Engineer",
  socialType = "website",
} = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "");
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html transition:animate="none" lang="en" data-obsidian={sculpture || undefined} data-pose={sculpture ? pose : undefined} {...stylex.attrs(portfolioStyles.document, sculpture && obsidianTheme)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FontPreload />
    <SiteIcons />
    {sculpture && <ThemeSetup />}
    <title>{title}</title>
    <meta name="author" content="Warre Snaet" />
    <meta name="robots" content={experimental ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <SocialMetadata {title} {description} {canonical} imagePath={socialImage} imageAlt={socialImageAlt} type={socialType} />
    <link rel="sitemap" type="application/xml" href={`${basePath}sitemap.xml`} />
    <StyleXDevStyles />
    <slot name="head" />
  </head>
  <body {...stylex.attrs(portfolioStyles.body)}>
    <slot />
    {sculpture && <><ThemeControl /><ObsidianScene /></>}
  </body>
</html>
